# Cliente Mac — Meeting Copilot (STT local + WS remoto pro servidor).
# Uso:  source config/mac-client.env
#
# A UI fica no SERVIDOR: http://100.87.25.101:8000/ui
# O STT roda no Mac (faster-whisper local); só o texto transcrito vai pela VPN.
# NÃO precisa de OPENROUTER_API_KEY aqui — o LLM roda no servidor.

# --- transporte ---
export API_WS_URL="ws://100.87.25.101:8000/ws"

# --- modelo local ---
export WHISPER_MODEL="small"

# --- modo real (sem áudio = MOCK_MODE=true, default do código) ---
export MOCK_MODE="false"

# --- fontes de áudio (ajuste ao que aparecer em check_audio.py) ---
export MIC_DEVICE="MacBook Pro Microphone"
export LOOPBACK_DEVICE="BlackHole 2ch"

# --- robustez da entrega (mesmos defaults do apps/stt/service.py) ---
export WS_QUEUE="200"
export WS_ACK_TIMEOUT="8.0"
export WS_PENDING_DIR="data/ws_pending"
